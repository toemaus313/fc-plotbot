  "version": "1.0.0",
  "description": "Discord bot for Elite Dangerous Fleet Carrier route plotting using Spansh API",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
